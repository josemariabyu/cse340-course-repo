<%- include('partials/header') %>

<h2><%= title %></h2>

<% if (errors && errors.length) { %>
  <ul class="form-errors" role="alert">
    <% errors.forEach(error => { %><li><%= error.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/edit-project/<%= project.project_id %>" method="POST" class="app-form">
  <label for="title">Project title</label>
  <input type="text" id="title" name="title" required maxlength="150" value="<%= project.title %>">

  <label for="organization_id">Organization</label>
  <select id="organization_id" name="organization_id" required>
    <% organizations.forEach(org => { %>
      <option value="<%= org.organization_id %>" <%= project.organization_id == org.organization_id ? 'selected' : '' %>><%= org.name %></option>
    <% }) %>
  </select>

  <label for="description">Description</label>
  <textarea id="description" name="description" required rows="4"><%= project.description %></textarea>

  <label for="location">Location</label>
  <input type="text" id="location" name="location" required maxlength="255" value="<%= project.location %>">

  <label for="date">Date</label>
  <input type="date" id="date" name="date" required value="<%= project.date ? project.date.toISOString().split('T')[0] : '' %>">
  
  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Update project</button>
    <a class="btn-link" href="/projects">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
