<%- include('partials/header') %>

<h2><%= title %></h2>

<% if (errors) { %>
    <ul style="color: #dc3545;">
        <% errors.forEach(error => { %>
            <li><%= error.msg %></li>
        <% }) %>
    </ul>
<% } %>

<form action="/projects/edit-project/<%= project.project_id %>" method="post" style="display: flex; flex-direction: column; gap: 1rem; max-width: 500px; margin-top: 1.5rem;">
    
    <!-- 🛡️ INPUT OCULTO (Lo que estudiamos para la teoría del examen) -->
    <input type="hidden" name="project_id" value="<%= project.project_id %>">

    <div>
        <label for="title" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Project Title:</label>
        <input type="text" id="title" name="title" value="<%= project.title %>" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <div>
        <label for="organization_id" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Organization (Partner):</label>
        <select id="organization_id" name="organization_id" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
            <% organizations.forEach(org => { %>
                <option value="<%= org.organization_id %>" <%= project.organization_id == org.organization_id ? 'selected' : '' %>><%= org.name %></option>
            <% }) %>
        </select>
    </div>

    <div>
        <label for="description" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Description:</label>
        <textarea id="description" name="description" required style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px; height: 100px;"><%= project.description %></textarea>
    </div>

    <div>
        <label for="location" style="display: block; font-weight: bold; margin-bottom: 0.3rem;">Location:</label>
        <input type="text" id="location" name="location" value="<%= project.location %>" style="width: 100%; padding: 0.5rem; border: 1px solid #ccc; border-radius: 4px;">
    </div>

    <button type="submit" style="background-color: #007bff; color: white; padding: 0.7rem; border: none; border-radius: 4px; font-weight: bold; cursor: pointer;">Update Project</button>
</form>

<div style="margin-top: 2rem;">
    <a href="/projects" style="color: #6c757d; text-decoration: none;">← Cancel and Back</a>
</div>

<%- include('partials/footer') %>
