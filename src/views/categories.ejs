<%- include('partials/header') %>

<h2>Categories</h2>
<p>Selecciona una categoría para explorar sus proyectos de servicio vinculados.</p>

<p><a class="btn btn-success" href="/new-category">+ New Category</a></p>

<ul class="data-list">
  <% categories.forEach(cat => { %>
    <li>
      <a class="item-name" href="/category/<%= cat.category_id %>"><%= cat.name %></a>
      <a class="btn-link" href="/edit-category/<%= cat.category_id %>">Edit</a>
    </li>
  <% }) %>
</ul>

<p><a class="btn-link" href="/">&larr; Volver al Inicio</a></p>

<%- include('partials/footer') %>
