<%- include('partials/header') %>

<h2>Edit Organization</h2>

<% if (errors && errors.length) { %>
  <ul class="form-errors" role="alert">
    <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/edit-organization/<%= organization.organization_id %>" method="POST" class="app-form">
  <label for="name">Organization name</label>
  <input type="text" id="name" name="name" required maxlength="150"
         value="<%= organization.name %>">

  <label for="description">Description</label>
  <textarea id="description" name="description" required rows="4"><%= organization.description || '' %></textarea>

  <label for="email">Email</label>
  <input type="email" id="email" name="email" required
         value="<%= organization.email || '' %>">

  <label for="image_url">Image URL</label>
  <input type="url" id="image_url" name="image_url" maxlength="255"
         value="<%= organization.image_url || '' %>">

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a class="btn-link" href="/organizations">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
