<%- include('partials/header') %>

<h2>Detalles del Proyecto: <%= project.title || "Service Project" %></h2>

<div class="project-card-detail" style="background: #f8f9fa; padding: 20px; border-radius: 5px; margin-top: 1.5rem;">
    <p><strong>Descripción:</strong> <%= project.description || "No description provided." %></p>
    <p><strong>Ubicación:</strong> <%= project.location || "Community Center" %></p>
    
    <div class="tags" style="margin-top: 1rem;">
        <strong>Categorías vinculadas:</strong>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <span style="background: #e2e3e5; padding: 3px 8px; border-radius: 3px; font-size: 0.9em; margin-right: 5px;"><%= cat.name %></span>
            <% }) %>
        <% } else { %>
            <span style="color: #6c757d; font-style: italic;">Ninguna categoría asignada</span>
        <% } %>
    </div>
</div>

<div style="margin-top: 2rem;">
    <a href="/projects" style="color: #007bff; text-decoration: none;">← Volver a Proyectos</a>
</div>

<%- include('partials/footer') %>
