<%- include('partials/header') %>

<h2>Detalles del Proyecto: <%= project.title %></h2>

<div class="project-card-detail" style="background: #f8f9fa; padding: 20px; border-radius: 5px; margin-top: 1.5rem;">
    <p><strong>Descripción:</strong> <%= project.description || "Sin descripción disponible." %></p>
    <p><strong>Ubicación:</strong> <%= project.location || "Centro Comunitario" %></p>
    <p><strong>Organización:</strong> <%= project.organization_name || "Organización Asociada" %></p>
    
    <div class="tags" style="margin-top: 1rem;">
        <strong>Categorías vinculadas:</strong>
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(cat => { %>
                <a href="/category/<%= cat.category_id %>" style="background: #e2e3e5; color: #383d41; padding: 4px 10px; border-radius: 3px; font-size: 0.9em; margin-right: 5px; text-decoration: none;">
                    🏷️ <%= cat.name %>
                </a>
            <% }) %>
        <% } else { %>
            <span style="color: #6c757d; font-style: italic;">Ninguna categoría asignada</span>
        <% } %>
    </div>
</div>
<div class="volunteer-section" style="margin-top: 1.5rem;">
    <% if (typeof user !== 'undefined' && user) { %>
        <% if (isUserVolunteering) { %>
            <p style="color: #155724; background: #d4edda; padding: 10px; border-radius: 5px;">
                ✅ You are volunteering for this project.
            </p>
            <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                <button type="submit" class="btn-link" style="background:none; border:none; color:#dc3545; cursor:pointer; padding:0;">
                    Remove myself as a volunteer
                </button>
            </form>
        <% } else { %>
            <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                <button type="submit" class="btn btn-primary">
                    Volunteer for this project
                </button>
            </form>
        <% } %>
    <% } %>
</div>

<% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
  <div style="margin-top:1rem;">
    <a href="/project/<%= project.project_id %>/categories" style="color:#007bff;">
      🏷️ Update categories
    </a>
  </div>
<% } %>

<div style="margin-top: 2rem;">
    <a href="/projects" style="color: #007bff; text-decoration: none;">← Volver a Proyectos</a>
</div>

<%- include('partials/footer') %>
