<%- include('partials/header') %>

<h2><%= title %></h2>
<p>Explora los proyectos de servicio activos en nuestra comunidad.</p>

<p><a class="btn btn-success" href="/new-project">+ New Project</a></p>

<ul class="data-list">
  <% projects.forEach(project => { %>
    <li>
      <a class="item-name" href="/project/<%= project.project_id %>"><%= project.name %></a>
      <span class="item-meta"><%= project.organization_name %></span>
      <a class="btn-link" href="/edit-project/<%= project.project_id %>">Edit</a>
    </li>
  <% }) %>
</ul>

<p><a class="btn-link" href="/">&larr; Volver al Inicio</a></p>

<%- include('partials/footer') %>

