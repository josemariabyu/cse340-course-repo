<%- include('partials/header') %>

<h2><%= title %></h2>

<% if (errors && errors.length) { %>
  <ul class="form-errors" role="alert">
    <% errors.forEach(error => { %><li><%= error.msg %></li><% }) %>
  </ul>
<% } %>

<form action="/new-project" method="POST" class="app-form">
  <label for="title">Project title</label>
  <input type="text" id="title" name="title" required maxlength="150" value="<%= oldData.title %>">

  <label for="organization_id">Organization</label>
  <select id="organization_id" name="organization_id" required>
    <option value="">-- Select an organization --</option>
    <% organizations.forEach(org => { %>
      <option value="<%= org.organization_id %>" <%= oldData.organization_id == org.organization_id ? 'selected' : '' %>><%= org.name %></option>
    <% }) %>
  </select>

  <label for="description">Description</label>
  <textarea id="description" name="description" required rows="4"><%= oldData.description %></textarea>

  <label for="location">Location</label>
  <input type="text" id="location" name="location" required maxlength="255" value="<%= oldData.location %>">

  <div class="form-actions">
    <button type="submit" class="btn btn-primary">Save project</button>
    <a class="btn-link" href="/projects">Cancel</a>
  </div>
</form>

<%- include('partials/footer') %>
