<%- include('partials/header') %>

<h2>Organizations</h2>
<p>Organizaciones registradas en la plataforma.</p>

<p><a class="btn btn-success" href="/new-organization">+ New Organization</a></p>

<ul class="data-list">
  <% organizations.forEach(org => { %>
    <li>
      <span class="item-name"><%= org.name %></span>
      <a class="btn-link" href="/edit-organization/<%= org.organization_id %>">Edit</a>
    </li>
  <% }) %>
</ul>

<p><a class="btn-link" href="/">&larr; Volver al Inicio</a></p>

<%- include('partials/footer') %>
