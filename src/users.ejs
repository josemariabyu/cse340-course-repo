<%- include('partials/header') %>

<h2>Registered Users</h2>
<p>Listado de todos los usuarios registrados en el sistema (solo administradores).</p>

<table class="data-table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Email (username)</th>
      <th>Role</th>
    </tr>
  </thead>
  <tbody>
    <% if (users.length === 0) { %>
      <tr><td colspan="3">No registered users yet.</td></tr>
    <% } %>
    <% users.forEach(u => { %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.email %></td>
        <td><span class="tag"><%= u.role %></span></td>
      </tr>
    <% }) %>
  </tbody>
</table>

<p><a class="btn-link" href="/dashboard">&larr; Back to dashboard</a></p>

<%- include('partials/footer') %>
